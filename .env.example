# Supply deployment values through the environment or the ignored .env.local file.
# The JS key is public and restricted to the approved domains.
AMAP_JS_KEY=
# Use this value exclusively on the server.
AMAP_SECURITY_CODE=
PORT=4173
# Optional Redis URL for the standalone server.
REDIS_URL=
# Comma-separated proxy IPs trusted to supply X-Forwarded-For for rate limits.
# Leave empty to use the socket peer address.
CAMPUS_TRUSTED_PROXY_IPS=
# Whole seconds. Position retention must exceed the 30-second capture window.
CAMPUS_EXPORT_RETENTION_SECONDS=3600
CAMPUS_POSITION_RETENTION_SECONDS=60
CAMPUS_POSITION_SWEEP_SECONDS=30
# MySQL 8.0.19+ for the standalone server. Leave empty for SQLite preview.
MYSQL_URL=
# Connections per Node instance, from 32 to 80. Budget for all instances on MySQL.
CAMPUS_MYSQL_POOL_SIZE=60
# Production: use wechat or roster. Local preview only: mock or demo.
# roster uses student number + name + phone last four and requires a phone column.
# mock runs the signup flow with fictional data. demo enables the original role preview.
CAMPUS_AUTH_MODE=roster
# Base64url encoding of at least 32 random bytes, generated separately for each deployment.
# PowerShell: $env:CAMPUS_JWT_SECRET = node -p "require('node:crypto').randomBytes(32).toString('base64url')"
CAMPUS_JWT_SECRET=
# HTTPS origin, e.g. https://campus.example.invalid. The loopback TLS proxy must
# preserve Host and overwrite X-Forwarded-Proto with https on HTTP and Socket.IO requests.
CAMPUS_PUBLIC_ORIGIN=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Comma-separated exact callback URLs. Include CAMPUS_PUBLIC_ORIGIN/api/auth/callback.
WECHAT_REDIRECT_ALLOWLIST=
# Approved absolute path outside the repo. UTF-8 CSV with school,student_no,name,phone.
# Leave empty in mock mode to use the fictional example. Manage real files outside Git.
CAMPUS_ROSTER_CSV=
# Set all three values to enable teacher login and the scheduled Top20 jobs on pnpm start.
# Accounts are comma-separated. Hashes are a JSON object keyed by the allowed accounts.
# Each hash is <base64url salt>.<base64url digest>. Use a random salt of at least 16 bytes
# and Node crypto.scrypt with a 64-byte digest and { N: 32768, r: 8, p: 3, maxmem: 67108864 }.
CAMPUS_TEACHER_ALLOWLIST=
CAMPUS_TEACHER_PASSWORD_HASHES=
# Generate separately from CAMPUS_JWT_SECRET using the same random-byte command above.
CAMPUS_TEACHER_JWT_SECRET=
# Resend sending API key and sender on a verified domain. Both empty leaves H5 invitations enabled.
CAMPUS_RESEND_API_KEY=
CAMPUS_MAIL_FROM=
# Async position persistence: production defaults to on; set 0 to roll back.
# 32 ordered write shards absorb MySQL stalls, then drain without surfacing write errors to clients.
CAMPUS_POSITION_WRITE_BEHIND=1
# Local verification only. Production refuses to start when this is set.
# CAMPUS_TEST_NOW=2026-11-23T06:31:00+08:00
