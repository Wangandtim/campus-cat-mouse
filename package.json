{
  "name": "campus-cat-mouse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "vue-tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env.local server/index.mjs",
    "test": "node --import ./server/auth/legacy-demo-env.mjs --test",
    "db:backup": "node server/db/backup.mjs",
    "db:import": "node server/db/import-sqlite.mjs"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "8.3.0",
    "@turf/boolean-point-in-polygon": "7.4.0",
    "@turf/distance": "7.4.0",
    "coordtransform": "2.1.2",
    "csv-parse": "7.0.3",
    "jose": "6.2.17",
    "jsqr": "1.4.0",
    "leaflet": "1.9.4",
    "lucide-vue-next": "0.511.0",
    "mysql2": "3.24.6",
    "qrcode": "1.5.4",
    "redis": "6.3.1",
    "socket.io": "4.8.4",
    "vue": "3.5.42"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.21",
    "@types/qrcode": "1.5.6",
    "@vitejs/plugin-vue": "6.0.3",
    "socket.io-client": "4.8.4",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vue-tsc": "3.1.8"
  }
}
